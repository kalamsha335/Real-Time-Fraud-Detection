# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Model Artifacts
MODEL_PATH=models/fraud_detection_xgboost.pkl
THRESHOLD_PATH=models/fraud_threshold.pkl

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fraud_detection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraud_detection

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTIONS_TOPIC=transactions
KAFKA_PREDICTIONS_TOPIC=fraud-predictions
KAFKA_ALERTS_TOPIC=fraud-alerts

# MLflow Configuration
MLFLOW_TRACKING_URI=sqlite:///notebooks/mlflow.db
MLFLOW_EXPERIMENT_NAME=Real-Time-Fraud-Detection

# Frontend Configuration
VITE_API_URL=http://localhost:8000

